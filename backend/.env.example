# ── Servidor ────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frutransport_db
DB_USER=postgres
DB_PASSWORD=tu_password

# Prisma (usar las mismas credenciales de arriba)
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/frutransport_db?schema=public"

# ── JWT ─────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor NO arranca si falta esta variable.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── ML Engine ───────────────────────────
ML_ENGINE_URL=http://localhost:8000
# Debe coincidir con el ML_INTERNAL_SECRET exportado al proceso de uvicorn
ML_INTERNAL_SECRET=

# ── CORS (solo se usa si NODE_ENV=production) ──
# Orígenes del frontend permitidos, separados por coma. Sin esta variable en
# producción, el servidor rechaza TODAS las peticiones cross-origin (fail-closed).
CORS_ORIGIN=https://tu-dominio-real.com

# ── Seed (solo Docker Compose) ──────────
# true = siembra usuarios demo + dataset de entrenamiento en cada arranque
# del contenedor — SOLO para la demo local, nunca en producción.
RUN_SEED=false

# Contraseñas de las cuentas que crea el seed. Si se dejan vacías, seed.js
# genera una aleatoria por cuenta (no imprime ni recupera después) — para
# tener credenciales conocidas y reproducibles en la demo, definir acá los
# mismos valores que credentials.md (gitignored, nunca subir con datos reales).
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_AUDITOR_PASSWORD=
SEED_CLIENTE1_PASSWORD=
SEED_CLIENTE2_PASSWORD=
